{% style %}
  {% # Loads all font variants with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {% # Headings font %}
  {% if settings.type_heading_font %}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {% endif %}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --font-body-family: var(--font-primary--family);
    --font-body-style: var(--font-primary--style);
    --font-body-weight: var(--font-primary--weight);

    {% if settings.type_heading_font %}
      --font-heading-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
      --font-heading-style: {{ settings.type_heading_font.style }};
      --font-heading-weight: {{ settings.type_heading_font.weight }};
    {% else %}
      --font-heading-family: var(--font-body-family);
      --font-heading-style: var(--font-body-style);
      --font-heading-weight: var(--font-body-weight);
    {% endif %}

    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    /* Brand color system — premium blue + white */
    --color-background: {{ settings.background_color | default: '#FFFFFF' }};
    --color-foreground: {{ settings.foreground_color | default: '#52677D' }};
    --color-heading: {{ settings.heading_color | default: '#102A43' }};
    --color-accent: {{ settings.accent_color | default: '#0057B8' }};
    --color-accent-deep: {{ settings.accent_deep_color | default: '#003B7A' }};
    --color-accent-bright: {{ settings.accent_bright_color | default: '#007BFF' }};
    --color-accent-foreground: {{ settings.accent_foreground_color | default: '#FFFFFF' }};
    --color-soft: {{ settings.soft_color | default: '#F4F8FC' }};
    --color-border: {{ settings.border_color | default: '#D9E8F7' }};
    --color-footer-background: {{ settings.footer_background_color | default: '#002B5C' }};
    --color-footer-text: {{ settings.footer_text_color | default: '#FFFFFF' }};
    --color-announcement-background: {{ settings.announcement_background_color | default: '#003B7A' }};
    --color-announcement-text: {{ settings.announcement_text_color | default: '#FFFFFF' }};

    /* Design token aliases */
    --nv-site-bg: var(--color-background);
    --nv-text-color: var(--color-foreground);
    --nv-primary-accent: var(--color-accent);
    --nv-primary-accent-hover: var(--color-accent-deep);
    --nv-secondary-accent: var(--color-accent-bright);
    --nv-light-blue: var(--color-soft);
    --nv-border-color: var(--color-border);

    /* Buttons */
    --primarybtnbg: var(--color-accent);
    --primarybtnhoverbg: var(--color-accent-deep);
    --primarybtncolor: var(--color-accent-foreground);
    --primarybtnhovercolor: var(--color-accent-foreground);
    --secondarybtncolor: var(--color-accent);
    --secondarybtnhovercolor: var(--color-accent-deep);

    /* Forms */
    --formfieldbgcolor: var(--color-background);
    --formfieldbordercolor: var(--color-border);
    --formfieldcolor: var(--color-heading);

    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 6 }}px;
    --style-border-radius-buttons: {{ settings.button_corner_radius | default: 4 }}px;
  }
{% endstyle %}