        "id": "accent_deep_color",
        "default": "#003B7A",
        "label": "t:labels.accent_deep_color"
      },
      {
        "type": "color",
        "id": "accent_bright_color",
        "default": "#007BFF",
        "label": "t:labels.accent_bright_color"
      },
      {
        "type": "color",
