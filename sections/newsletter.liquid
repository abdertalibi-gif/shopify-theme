{%- comment -%}
  Newsletter signup — customer form with newsletter tag.
{%- endcomment -%}

<div class="section {% if section.settings.soft_background %}section--soft{% endif %}">
  <div class="page-width">
    <div class="newsletter reveal">
      <div class="newsletter__inner">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="newsletter__text">{{ section.settings.text }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'newsletter_form', class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            class="newsletter__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.placeholder | escape }}"
            aria-label="{{ 'newsletter.email' | t }}"
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <button class="btn" type="submit" name="commit">
            {{ section.settings.button_label | escape }}
          </button>
        {%- endform -%}

        {% # theme-check-disable UndefinedObject %}
        {%- if form.posted_successfully? -%}
          <p class="newsletter__note" style="color: var(--color-accent);">
            {{ 'newsletter.success' | t }}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <p class="newsletter__errors">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}
        {% # theme-check-enable UndefinedObject %}

        {%- if section.settings.note != blank -%}
          <p class="newsletter__note">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Restez inspiré"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "Inscrivez-vous pour recevoir nos nouveautés, offres exclusives et conseils en avant-première."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:labels.placeholder",
      "default": "Votre adresse e-mail"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "S'inscrire"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:labels.note",
      "default": "En vous inscrivant, vous acceptez de recevoir nos emails. Désinscription en un clic."
    },
    {
      "type": "checkbox",
      "id": "soft_background",
      "label": "t:labels.soft_background",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ]
}
{% endschema %}