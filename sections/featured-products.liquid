{%- comment -%}
  Best-selling products — displays products from a chosen
  collection, sorted by best sellers.
{%- endcomment -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 8
  assign per_row = section.settings.columns | default: 4
  assign products = collection.products | sort_by: 'best-selling' | slice: 0, products_to_show
-%}

<div class="section {% if section.settings.soft_background %}section--soft{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if products.size > 0 -%}
      <div class="product-grid" style="--products-per-row: {{ per_row }}">
        {%- for product in products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="text-center">{{ 'products.no_products' | t }}</p>
    {%- endif -%}

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="section-heading__action text-center mt-4">
        <a class="btn btn--secondary" href="{{ collection.url }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.featured_products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Coup de cœur"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Best-sellers"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Les pièces préférées de nos clients, sélectionnées pour vous."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "t:labels.products_to_show",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_view_all",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.view_all_label",
      "default": "Voir toute la collection"
    },
    {
      "type": "checkbox",
      "id": "soft_background",
      "label": "t:labels.soft_background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_products"
    }
  ]
}
{% endschema %}