{%- comment -%}
  Featured collections grid — configurable collections with
  large lifestyle imagery.
{%- endcomment -%}

{%- assign per_row = section.settings.columns | default: 3 -%}

<div class="section {% if section.settings.soft_background %}section--soft{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="featured-collections__grid" style="--collections-per-row: {{ per_row }}">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          {%- if collection == blank -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign collection_image = collection.featured_image -%}
          {%- if collection_image == blank and collection.products.first.featured_image -%}
            {%- assign collection_image = collection.products.first.featured_image -%}
          {%- endif -%}

          <a class="collection-card reveal" href="{{ collection.url }}" {{ block.shopify_attributes }} style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms;">
            {%- if collection_image -%}
              <div class="collection-card__image">
                {{ collection_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 720, 800', sizes: '(min-width: 990px) 33vw, (min-width: 560px) 50vw, 100vw' }}
              </div>
            {%- endif -%}
            <div class="collection-card__overlay"></div>
            <div class="collection-card__content">
              <h3 class="collection-card__title">{{ collection.title | escape }}</h3>
              {%- if section.settings.show_product_count -%}
                <span class="collection-card__count">
                  {{ collection.products_count }} {{ 'collections.products' | t }}
                </span>
              {%- endif -%}
              <span class="collection-card__link">
                {{ section.settings.card_button_label | escape }}
                {% render 'icon', icon: 'arrow-right' %}
              </span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.featured_collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Nos univers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Collections vedettes"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Explorez nos univers soigneusement sélectionnés pour vous."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:labels.show_product_count",
      "default": true
    },
    {
      "type": "text",
      "id": "card_button_label",
      "label": "t:labels.card_button_label",
      "default": "Explorer"
    },
    {
      "type": "checkbox",
      "id": "soft_background",
      "label": "t:labels.soft_background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:labels.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collections",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}