{%- comment -%}
  Product benefits — Livraison rapide, Paiement sécurisé,
  Retours faciles, Support client.
{%- endcomment -%}

{%- assign per_row = section.settings.columns | default: 4 -%}

<div class="section {% if section.settings.soft_background %}section--soft{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="section-heading">
        {%- if section.settings.eyebrow != blank -%}
          <span class="section-heading__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="benefits__grid" style="--benefits-per-row: {{ per_row }}">
        {%- for block in section.blocks -%}
          <div class="benefit-card reveal" {{ block.shopify_attributes }} style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms;">
            <div class="benefit-card__icon">
              {% render 'icon', icon: block.settings.icon %}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="benefit-card__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="benefit-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.product_benefits",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Nos engagements"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Une expérience premium"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Des services pensés pour votre satisfaction."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.columns",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "soft_background",
      "label": "t:labels.soft_background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:labels.benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:labels.icon",
          "options": [
            { "value": "truck", "label": "t:options.icon.truck" },
            { "value": "shield", "label": "t:options.icon.shield" },
            { "value": "returns", "label": "t:options.icon.returns" },
            { "value": "support", "label": "t:options.icon.support" },
            { "value": "check", "label": "t:options.icon.check" },
            { "value": "phone", "label": "t:options.icon.phone" },
            { "value": "pin", "label": "t:options.icon.pin" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Livraison rapide"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:labels.text",
          "default": "Livraison express 24/48h partout au Maroc."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.product_benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Livraison rapide",
            "text": "Livraison express 24/48h partout au Maroc."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Paiement sécurisé",
            "text": "Transactions cryptées et 100% sécurisées."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "returns",
            "title": "Retours faciles",
            "text": "Satisfait ou remboursé sous 14 jours."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "title": "Support client",
            "text": "Une équipe à votre écoute 7j/7."
          }
        }
      ]
    }
  ]
}
{% endschema %}