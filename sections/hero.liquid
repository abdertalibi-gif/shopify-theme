{%- comment -%}
  Hero section — large lifestyle image with French headline,
  subtitle and conversion-focused CTAs.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign alignment = section.settings.text_alignment
  assign height = section.settings.height
  assign hero_text_color = section.settings.text_color | default: '#FFFFFF'
-%}

<div class="hero hero--{{ alignment }} hero--{{ height }} full-width" style="--hero-text-color: {{ hero_text_color }}; --hero-position: {{ section.settings.image_position }}">
  {%- if image != blank -%}
    <div class="hero__media">
      {{ image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1780, 2000, 2400', sizes: '100vw' }}
    </div>
    {%- if section.settings.show_overlay -%}
      <div class="hero__overlay" style="--hero-overlay-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
    {%- endif -%}
  {%- else -%}
    <div class="hero__media hero__media--placeholder" style="background: linear-gradient(135deg, var(--color-soft), var(--color-accent));"></div>
    <div class="hero__overlay" style="--hero-overlay-color: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});"></div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow reveal" style="color: {{ hero_text_color }};">{{ section.settings.eyebrow | escape }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title reveal" style="--reveal-delay: 100ms;">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <p class="hero__subtitle reveal" style="--reveal-delay: 200ms;">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank -%}
      <div class="hero__ctas reveal" style="--reveal-delay: 300ms;">
        {%- if section.settings.primary_button_label != blank -%}
          <a class="btn btn--light" href="{{ section.settings.primary_button_link | default: routes.root_url }}">
            {{ section.settings.primary_button_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a class="btn btn--light-secondary" href="{{ section.settings.secondary_button_link | default: routes.root_url }}">
            {{ section.settings.secondary_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Nouvelle collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "L'élégance au quotidien"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:labels.subtitle",
      "default": "Des pièces premium soigneusement sélectionnées pour sublimer votre style. Livraison rapide partout au Maroc."
    },
    {
      "type": "header",
      "content": "t:labels.buttons"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "t:labels.primary_button_label",
      "default": "Découvrir la collection"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "t:labels.primary_button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.secondary_button_label",
      "default": "Nos best-sellers"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:labels.secondary_button_link"
    },
    {
      "type": "header",
      "content": "t:labels.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "center", "label": "t:options.position.center" },
        { "value": "top", "label": "t:options.position.top" },
        { "value": "bottom", "label": "t:options.position.bottom" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "t:labels.show_overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:labels.layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:labels.height",
      "options": [
        { "value": "small", "label": "t:options.size.small" },
        { "value": "medium", "label": "t:options.size.medium" },
        { "value": "large", "label": "t:options.size.large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}