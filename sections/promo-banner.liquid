{%- comment -%}
  Promotional banner — full-width callout with image,
  headline and CTA.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign alignment = section.settings.text_alignment
  assign overlay_opacity = section.settings.overlay_opacity | default: 45
-%}

<div class="section section--full-width">
  <div class="page-width">
    <div
      class="promo-banner promo-banner--{{ alignment }} reveal"
      style="--promo-bg: {{ section.settings.background_color | default: '#9A6B4F' }}; --promo-fg: {{ section.settings.text_color | default: '#FFFFFF' }}; --promo-overlay: rgba(0, 0, 0, {{ overlay_opacity | divided_by: 100.0 }});"
    >
      {%- if image != blank -%}
        <div class="promo-banner__media">
          {{ image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw' }}
        </div>
        <div class="promo-banner__overlay"></div>
      {%- endif -%}

      <div class="promo-banner__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="promo-banner__eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="promo-banner__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="promo-banner__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <div class="promo-banner__cta">
            <a class="btn btn--light" href="{{ section.settings.button_link | default: routes.root_url }}">
              {{ section.settings.button_label | escape }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.promo_banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Offre limitée"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Jusqu'à -30% sur la nouvelle collection"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.text",
      "default": "Profitez de réductions exclusives pendant une durée limitée. Livraison offerte dès 500 MAD."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "J'en profite"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "t:labels.overlay_opacity",
      "default": 45
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:labels.text_alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background_color",
      "default": "#9A6B4F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "t:general.promo_banner"
    }
  ]
}
{% endschema %}